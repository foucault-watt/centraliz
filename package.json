{
  "name": "centraliz-root",
  "version": "1.1",
  "scripts": {
    "go": "concurrently \"npm --prefix frontend start\" \"npm --prefix backend run dev\"",
    "pokemon:start": "wsl.exe --cd %cd% -e bash -lc \"GAME_RUNNER_DIR=$HOME/pokemon-cloud ./game-runner/bin/start-local.sh\"",
    "pokemon:stop": "wsl.exe --cd %cd% -e bash -lc \"GAME_RUNNER_DIR=$HOME/pokemon-cloud ./game-runner/bin/stop-local.sh\"",
    "pokemon:dev": "npm run pokemon:start && npm run go",
    "install-all": "concurrently \"npm --prefix frontend install\" \"npm --prefix backend install\"",
    "audit-fix": "concurrently \"npm --prefix frontend audit fix\" \"npm --prefix backend audit fix\"",
    "build": "npm --prefix frontend run build",
    "deploy": "node deploy.js",
    "rezo": "npm run build && npm run deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.1",
    "cli-progress": "^3.12.0",
    "colors": "^1.4.0",
    "concurrently": "^8.0.1",
    "culori": "^3.2.0",
    "dotenv": "^16.4.7",
    "ora": "^5.4.1",
    "ssh2-sftp-client": "^12.0.0",
    "tailwindcss": "^4.1.1"
  }
}