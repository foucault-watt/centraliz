# Copiez ce fichier vers game-runner.env sur le serveur, puis adaptez les chemins.
# Ce format est lu à la fois par Bash et par systemd : pas d'espace autour de =.

DISPLAY_ID=:98
SCREEN_GEOMETRY=1024x768x24

MGBA_BIN=/usr/games/mgba-qt
ROM_PATH=/home/fwattinne/centraliz/game-runner/roms/game.gba
LUA_SCRIPT_PATH=/home/fwattinne/centraliz/game-runner/tools/mgba-http/mGBASocketServer.lua
MGBA_HTTP_BIN=/home/fwattinne/centraliz/game-runner/tools/mgba-http/mgba-http

LUA_HOST=127.0.0.1
LUA_PORT=8888
MGBA_HTTP_URL=http://127.0.0.1:5000

# Délais maximaux avant qu'un démarrage soit déclaré en échec.
WINDOW_TIMEOUT_SECONDS=30
LUA_TIMEOUT_SECONDS=30
HTTP_TIMEOUT_SECONDS=15

# Coordonnées relatives aux fenêtres mGBA 0.10.x en 1024x768.
# Elles restent configurables si le thème ou la version de mGBA change.
MGBA_WINDOW_NAME=mGBA
SCRIPTING_WINDOW_NAME=Scripting
TOOLS_MENU_X=500
TOOLS_MENU_Y=218
SCRIPTING_ITEM_X=500
SCRIPTING_ITEM_Y=355
SCRIPT_FILE_MENU_X=15
SCRIPT_FILE_MENU_Y=25
LOAD_SCRIPT_ITEM_X=15
LOAD_SCRIPT_ITEM_Y=55
